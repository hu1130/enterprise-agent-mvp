# Local Agent HTTP service
PORT=8788
AGENT_HOST=127.0.0.1
AGENT_API_TOKEN=change-me-local-token
AGENT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8788,http://127.0.0.1:8788

# Authorized local workspace
AGENT_ALLOWED_WORKSPACE=data/workspace
AGENT_MAX_FILE_BYTES=200000
AGENT_USER_POLICY_FILE=data/users.example.json

# Optional model gateway: OpenAI-compatible or local compatible endpoint
# Example for local OpenAI-compatible server:
# AGENT_MODEL_API_URL=http://127.0.0.1:11434/v1/chat/completions
AGENT_MODEL_API_URL=
AGENT_MODEL_NAME=local-model
AGENT_MODEL_API_KEY=

# Optional SMTP email sending. Real sends still require pending approval.
AGENT_SMTP_HOST=
AGENT_SMTP_PORT=587
AGENT_SMTP_USER=
AGENT_SMTP_PASSWORD=
AGENT_SMTP_FROM=
AGENT_SMTP_TLS=true

# Optional calendar export
AGENT_CALENDAR_EXPORT_DIR=data/calendar

# Optional allowlists. Empty means blocked.
AGENT_WEB_ALLOWED_HOSTS=
AGENT_INTERNAL_ALLOWED_HOSTS=
AGENT_SCRIPT_ALLOWLIST=
AGENT_SCRIPT_TIMEOUT_SECONDS=15

